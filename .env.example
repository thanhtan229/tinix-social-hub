# Tinix Social Studio - PC-first configuration
TINIX_HOST=127.0.0.1
TINIX_PORT=8765
TINIX_OPEN_BROWSER=true
# false lets the WebUI/controller and `python -m app.worker_entry` run separately.
TINIX_EMBEDDED_WORKER=true
TINIX_MAX_CONCURRENT_JOBS=2
TINIX_MAX_CHROME=2
TINIX_JOB_POLL_SECONDS=2
TINIX_SCHEDULER_SECONDS=15
TINIX_CLOSE_CHROME_AFTER_JOB=false
TINIX_SCREENSHOT_RETENTION_DAYS=14
TINIX_TEMP_RETENTION_HOURS=48
TINIX_MAINTENANCE_SECONDS=21600

# Optional absolute paths. Relative paths are resolved from the project folder.
# TINIX_DATA_DIR=data
# TINIX_MEDIA_DIR=media
# TINIX_EXPORT_DIR=exports
# TINIX_BACKUP_DIR=data/backups
# TINIX_LOG_DIR=logs
# TINIX_CHROME_PROFILE_DIR=chrome_profiles
# TINIX_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ==============================================================================
# 1. CẤU HÌNH AI STUDIO / AGENT (Gemini, DeepSeek, OpenAI...)
# Tinix Social Hub hỗ trợ mọi dịch vụ AI theo chuẩn OpenAI-Compatible API.
# Mặc định chưa kích hoạt cho đến khi bạn điền API Key.
# ==============================================================================

# --- TÙY CHỌN 1: GOOGLE GEMINI (Khuyên dùng - Lấy API key miễn phí tại https://aistudio.google.com/) ---
TINIX_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
TINIX_AI_MODEL=gemini-2.5-flash
TINIX_AI_API_KEY=
TINIX_AI_TIMEOUT_SECONDS=60
TINIX_AI_MAX_RETRIES=2

# --- TÙY CHỌN 2: DEEPSEEK (Nếu dùng DeepSeek, bỏ comment các dòng dưới và comment tùy chọn 1) ---
# TINIX_AI_BASE_URL=https://api.deepseek.com
# TINIX_AI_MODEL=deepseek-chat
# TINIX_AI_API_KEY=sk-your-deepseek-api-key

# --- TÙY CHỌN 3: OPENAI (Nếu dùng ChatGPT/OpenAI) ---
# TINIX_AI_BASE_URL=https://api.openai.com/v1
# TINIX_AI_MODEL=gpt-4o-mini
# TINIX_AI_API_KEY=sk-your-openai-api-key


# ==============================================================================
# 2. CÁC NỀN TẢNG MẠNG XÃ HỘI (Facebook, TikTok, Instagram, X/Twitter)
# ==============================================================================
# LƯU Ý QUAN TRỌNG:
# Facebook, TikTok, Instagram và X KHÔNG CẦN VÀ KHÔNG DÙNG API KEY trong file .env!
# Lý do: Tinix Social Hub sử dụng công nghệ Chrome Profile Automation (tự động hóa trình duyệt).
# Cách kích hoạt tài khoản:
#   1. Khởi động Tinix Hub và mở tab "Tài khoản & Page"
#   2. Bấm nút "+ Thêm account" và chọn nền tảng (Facebook / TikTok / X / Instagram)
#   3. Bấm "Mở Chrome" -> Cửa sổ trình duyệt riêng sẽ mở ra
#   4. Đăng nhập tài khoản trên web như bình thường (hỗ trợ đầy đủ 2FA, giải captcha)
#   5. Quay lại Tinix bấm "Kiểm tra login" và "Đồng bộ Page/Kênh".


# ==============================================================================
# 3. YOUTUBE (Tùy chọn Official Google Data API v3)
# ==============================================================================
# Mặc định YouTube vẫn hoạt động qua Chrome Automation mà KHÔNG CẦN điền các dòng dưới.
# Nếu bạn muốn kết nối qua Google Cloud Console OAuth 2.0 chính thức thì mới cần điền:
TINIX_YOUTUBE_CLIENT_ID=
TINIX_YOUTUBE_CLIENT_SECRET=
TINIX_YOUTUBE_REDIRECT_URI=http://127.0.0.1:8765/api/oauth/youtube/callback
TINIX_PROVIDER_TIMEOUT_SECONDS=120

